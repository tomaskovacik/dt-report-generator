# Copy to .env (next to app.py) and fill in. Real environment variables win
# over this file; DTRG_ENV_FILE points dtrg at a different file.

# --- Dependency-Track (required) ---
# API key needs VIEW_PORTFOLIO and VIEW_VULNERABILITY
DT_URL=https://dtrack.example.com
DT_TOKEN=odt_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Web server ---
DTRG_HOST=127.0.0.1
DTRG_PORT=5000
# stable key so sessions survive restarts: python -c 'import secrets; print(secrets.token_hex(32))'
DTRG_SECRET_KEY=
# true when served over HTTPS
DTRG_SECURE_COOKIES=false

# --- Microsoft Entra ID single sign-on (optional, see README) ---
DTRG_OIDC_TENANT_ID=
DTRG_OIDC_CLIENT_ID=
DTRG_OIDC_CLIENT_SECRET=
# DTRG_OIDC_ALLOWED_USERS=*@example.com
# DTRG_OIDC_REDIRECT_URI=https://dtrg.example.com/auth/callback

# --- CI API (/api/v1/*) ---
# DTRG_API_KEY=

# --- Dashboard fix-version lookups ---
# any GitHub token, no scopes needed: raises the advisory API limit to 5000/h
# DTRG_GITHUB_TOKEN=
# true (default): the dashboard calls api.github.com/advisories (fix versions),
# repo1.maven.org (is the fix publicly released? Spring Boot BOMs for the
# Spring Boot upgrade target and the quick-fix overrides) and
# registry.npmjs.org. Only public library names / versions and advisory ids
# are sent. Lookups are best effort: if they fail the report is still built.
# false: no outbound calls except to DT. Use on servers without internet
# access; fix versions then come only from DT's affected-version ranges, and
# the Spring Boot target and quick fixes are not shown.
# DTRG_DASHBOARD_ENRICH=true
