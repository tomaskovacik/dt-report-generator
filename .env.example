# Copy to .env (next to app.py) and fill in. Real environment variables win
# over this file; DTRG_ENV_FILE points dtrg at a different file.

# --- Dependency-Track (required) ---
# API key needs VIEW_PORTFOLIO and VIEW_VULNERABILITY
DT_URL=https://dtrack.example.com
DT_TOKEN=odt_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Web server ---
DTRG_HOST=127.0.0.1
DTRG_PORT=5000
# stable key so sessions survive restarts: python -c 'import secrets; print(secrets.token_hex(32))'
DTRG_SECRET_KEY=
# true when served over HTTPS
DTRG_SECURE_COOKIES=false

# --- Microsoft Entra ID single sign-on (optional, see README) ---
DTRG_OIDC_TENANT_ID=
DTRG_OIDC_CLIENT_ID=
DTRG_OIDC_CLIENT_SECRET=
# DTRG_OIDC_ALLOWED_USERS=*@example.com
# DTRG_OIDC_REDIRECT_URI=https://dtrg.example.com/auth/callback

# --- CI API (/api/v1/*) ---
# DTRG_API_KEY=

# --- Dashboard fix-version lookups ---
# any GitHub token, no scopes needed: raises the advisory API limit to 5000/h
# DTRG_GITHUB_TOKEN=
# true (default): the dashboard calls api.github.com/advisories (fix versions),
# repo1.maven.org (is the fix publicly released? Spring Boot BOMs for the
# Spring Boot upgrade target and the quick-fix overrides) and
# registry.npmjs.org. Only public library names / versions and advisory ids
# are sent. Lookups are best effort: if they fail the report is still built.
# false: no outbound calls except to DT. Use on servers without internet
# access; fix versions then come only from DT's affected-version ranges, and
# the Spring Boot target and quick fixes are not shown.
# DTRG_DASHBOARD_ENRICH=true

# --- Reports by email (send now + scheduled) ---
# smtp | graph; empty = email off. Email also stays off until DTRG_MAIL_FROM
# and DTRG_MAIL_ALLOWED_RECIPIENTS are set.
DTRG_MAIL_BACKEND=
# sender address (for graph: the mailbox dtrg sends as)
DTRG_MAIL_FROM=dtrg@example.com
# reports contain vulnerability details: only these recipients are accepted
# (comma separated, globs allowed)
DTRG_MAIL_ALLOWED_RECIPIENTS=*@example.com
# link back to dtrg shown in the email (optional)
# DTRG_PUBLIC_URL=https://dtrg.example.com
# schedules ("every Monday at 07:00") are in this timezone
DTRG_TIMEZONE=Europe/Bratislava
# SMTP: starttls (587) | ssl (465) | none (25)
# DTRG_SMTP_HOST=smtp.example.com
# DTRG_SMTP_PORT=587
# DTRG_SMTP_SECURITY=starttls
# DTRG_SMTP_USER=
# DTRG_SMTP_PASSWORD=
# Microsoft Graph: app registration with the Mail.Send *application*
# permission (admin consent). Defaults to the DTRG_OIDC_* values, so the SSO
# app registration can be reused. Limit it to the sender mailbox with an
# Exchange application access policy / RBAC for Applications.
# DTRG_GRAPH_TENANT_ID=
# DTRG_GRAPH_CLIENT_ID=
# DTRG_GRAPH_CLIENT_SECRET=
# where subscriptions are stored (SQLite); the Docker image uses /data
# DTRG_DATA_DIR=./data

# --- Web server (Docker image runs gunicorn) ---
# DTRG_THREADS=8
# DTRG_REQUEST_TIMEOUT=600

